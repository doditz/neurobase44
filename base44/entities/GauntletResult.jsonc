{
  "name": "GauntletResult",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "ID of the gauntlet run batch"
    },
    "model_name": {
      "type": "string",
      "default": "Default LLM (InvokeLLM)",
      "description": "Name of the LLM model tested"
    },
    "question_id": {
      "type": "string",
      "description": "Reference to the question ID"
    },
    "question": {
      "type": "string",
      "description": "The test question asked"
    },
    "model_answer": {
      "type": "string",
      "description": "The answer generated by the model"
    },
    "time_taken_ms": {
      "type": "integer",
      "description": "Time taken by the model to respond in milliseconds"
    },
    "judge_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Score given by the judge model (1-10)"
    },
    "judge_reasoning": {
      "type": "string",
      "description": "Reasoning provided by the judge model"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "judged",
        "timeout",
        "error"
      ],
      "default": "pending",
      "description": "Status of the test item"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if any"
    },
    "d2_config": {
      "type": "object",
      "description": "D2 modulation configuration used",
      "properties": {
        "d2_stim": {
          "type": "number"
        },
        "d2_pin": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "run_id",
    "question",
    "status"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}