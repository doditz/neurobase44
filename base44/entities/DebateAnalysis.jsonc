{
  "name": "DebateAnalysis",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID de la conversation associ\u00e9e"
    },
    "debate_id": {
      "type": "string",
      "description": "ID du d\u00e9bat analys\u00e9"
    },
    "analysis_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Quand l'analyse a \u00e9t\u00e9 effectu\u00e9e"
    },
    "personas_participated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des personas qui ont particip\u00e9"
    },
    "total_rounds": {
      "type": "integer",
      "description": "Nombre total de rondes de d\u00e9bat"
    },
    "key_arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "persona": {
            "type": "string"
          },
          "argument": {
            "type": "string"
          },
          "strength_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supporting_evidence": {
            "type": "string"
          }
        }
      },
      "description": "Arguments cl\u00e9s identifi\u00e9s dans le d\u00e9bat"
    },
    "logical_fallacies_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fallacy_type": {
            "type": "string",
            "enum": [
              "ad_hominem",
              "straw_man",
              "false_dichotomy",
              "hasty_generalization",
              "circular_reasoning",
              "appeal_to_authority",
              "slippery_slope",
              "red_herring",
              "appeal_to_emotion",
              "none_detected"
            ]
          },
          "persona": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "moderate",
              "major"
            ]
          }
        }
      },
      "description": "Erreurs logiques d\u00e9tect\u00e9es"
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "confidence_level": {
            "type": "string",
            "enum": [
              "no_evidence",
              "weak_evidence",
              "needs_verification"
            ]
          }
        }
      },
      "description": "Affirmations non support\u00e9es d\u00e9tect\u00e9es"
    },
    "consensus_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Points de consensus identifi\u00e9s"
    },
    "disagreement_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "persona": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                }
              }
            }
          },
          "resolution_achieved": {
            "type": "boolean"
          }
        }
      },
      "description": "Points de d\u00e9saccord"
    },
    "debate_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Score de qualit\u00e9 global du d\u00e9bat"
    },
    "argument_diversity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Score de diversit\u00e9 des arguments"
    },
    "reasoning_depth_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Score de profondeur du raisonnement"
    },
    "persona_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "persona_name": {
            "type": "string"
          },
          "contribution_quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unique_insights": {
            "type": "integer"
          },
          "interaction_quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "description": "Contributions individuelles de chaque persona"
    },
    "synthesis_alignment_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Alignement de la synth\u00e8se finale avec les arguments du d\u00e9bat"
    },
    "overall_summary": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 global de l'analyse du d\u00e9bat"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommandations pour am\u00e9liorer futurs d\u00e9bats"
    }
  },
  "required": [
    "conversation_id",
    "analysis_timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}