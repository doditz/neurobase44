{
  "name": "TriLlmStream",
  "type": "object",
  "properties": {
    "stream_id": {
      "type": "string",
      "description": "Unique id generated by the client to correlate a tri-LLM run with its live progress"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "phase1",
        "phase2",
        "phase3",
        "done",
        "error"
      ],
      "default": "pending",
      "description": "Current phase of the tri-LLM debate pipeline"
    },
    "phase_label": {
      "type": "string",
      "description": "Human-readable label of the current phase for live display"
    },
    "complexity_level": {
      "type": "integer",
      "description": "4 or 5"
    },
    "models_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "phase1_done": {
            "type": "boolean"
          },
          "phase2_done": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "description": "Per-model completion status for live progress"
    },
    "debate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round": {
            "type": "integer"
          },
          "persona": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      },
      "description": "Incrementally appended debate transcript (Phase 1 drafts, then Phase 2 revisions)"
    },
    "synthesis_preview": {
      "type": "string",
      "description": "Final synthesis text once Phase 3 completes"
    },
    "error_message": {
      "type": "string",
      "description": "Error detail if status is error"
    }
  },
  "required": [
    "stream_id"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}